ENV=development

# Database — SQLite by default. For Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/gstlite
DATABASE_URL=sqlite:///./gstlite.db

# Change this in production
SECRET_KEY=change-me-to-a-long-random-string

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# OCR: "mock" (no dependencies needed) or "tesseract" (requires the Tesseract binary + pytesseract/pdf2image)
OCR_PROVIDER=mock

# AI advisor: leave unset to use the built-in rule-based canned responses.
# Set this to enable real GPT-4o-grounded answers in the chat endpoint.
OPENAI_API_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
